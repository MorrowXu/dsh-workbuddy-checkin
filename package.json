{
  "name": "dsh-workbuddy-checkin",
  "displayName": "WorkBuddy 一键打卡",
  "description": "在侧边栏扩展功能区显示 WorkBuddy 登录状态，已登录时可一键领取每日积分，并查看余额与连登进度。",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "credentials.js",
    "upstream.js",
    "store.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "checkin",
    "cordis"
  ],
  "author": "MorrowXu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MorrowXu/dsh-workbuddy-checkin.git"
  },
  "homepage": "https://github.com/MorrowXu/dsh-workbuddy-checkin#readme",
  "bugs": {
    "url": "https://github.com/MorrowXu/dsh-workbuddy-checkin/issues"
  },
  "license": "MIT"
}
